[build-system]
requires = ["hatchling>=1.27"]
build-backend = "hatchling.build"

[project]
name = "{{PACK_SLUG}}"
version = "0.1.0"
description = "Runtime for the {{PACK_NAME}} swarm pack (generated by Decision Swarm)."
requires-python = ">=3.10"
dependencies = ["decision-swarm>=0.1.0"]

[project.scripts]
{{PACK_SLUG}} = "{{PACK_MODULE}}.cli:main"

[tool.hatch.build.targets.wheel]
packages = ["src/{{PACK_MODULE}}"]
