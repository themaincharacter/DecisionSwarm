"""Command line for the {{PACK_NAME}} swarm pack."""

from __future__ import annotations

import argparse
import sys
from collections.abc import Sequence

from {{PACK_MODULE}} import load_manifest


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="{{PACK_SLUG}}",
        description="Run the {{PACK_NAME}} swarm pack.",
    )
    subparsers = parser.add_subparsers(dest="command", metavar="<command>", required=True)
    subparsers.add_parser("inspect", help="list this pack's cells")
    run_parser = subparsers.add_parser("run", help="run the pack against an observation")
    run_parser.add_argument("--input", required=True, metavar="FILE", help="observation payload (JSON)")
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    manifest = load_manifest()
    if args.command == "inspect":
        for cell in manifest.cells:
            print(f"{cell.id}: {cell.model} [{', '.join(cell.views)}]")
        return 0
    print("{{PACK_SLUG}}: 'run' is not implemented yet", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
