"""Command line for the {{PACK_NAME}} swarm pack.

Thin shim: this package embeds the pack's manifest, so every command delegates to
the engine with that manifest. One implementation, no drift from `decision-swarm`.
"""

from __future__ import annotations

import sys
from collections.abc import Sequence

from decision_swarm.cli import main as cli_main

from {{PACK_MODULE}} import MANIFEST_PATH

COMMANDS = ("inspect", "run", "serve", "mcp")


def main(argv: Sequence[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] not in COMMANDS:
        print("{{PACK_SLUG}}: expected one of: " + ", ".join(COMMANDS), file=sys.stderr)
        return 2
    return cli_main([args[0], "--pack", str(MANIFEST_PATH), *args[1:]])


if __name__ == "__main__":
    sys.exit(main())
