"""Runtime for the {{PACK_NAME}} swarm pack (generated by Decision Swarm)."""

from __future__ import annotations

from pathlib import Path

from decision_swarm.manifest import SwarmManifest, load_manifest as _load_manifest

PACK_NAME = "{{PACK_NAME}}"
MANIFEST_PATH = Path(__file__).with_name("swarm.json")
"""The ``swarm.json`` embedded in this package at build time."""


def load_manifest() -> SwarmManifest:
    """Load the manifest embedded in this runtime package."""
    return _load_manifest(MANIFEST_PATH)
