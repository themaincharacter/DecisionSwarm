{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Decision Swarm",
  "version": "0.6.0",
  "identifier": "dev.decisionswarm.gui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Decision Swarm",
        "width": 1240,
        "height": 860
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "Decision Swarm contributors",
    "copyright": "Copyright (c) 2026 Decision Swarm contributors",
    "license": "Apache-2.0",
    "shortDescription": "Assemble a swarm of Laya decision-model sensors over one observation.",
    "longDescription": "Decision Swarm desktop app: configure a swarm of decision-model cells over one observation, download their checkpoints, and package the swarm as a runnable artifact. The decision-swarm engine is bundled — no Python or git checkout required.",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
